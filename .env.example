# Canonical URL for the registered KIKORA website domain.
NEXT_PUBLIC_SITE_URL=https://kikoragear.com
# Public support inbox used across the website and email reply links.
NEXT_PUBLIC_SUPPORT_EMAIL=support@kikoragear.com

# Future Shopify Storefront API placeholders.
# Do not add Admin API secrets or payment credentials to frontend code.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token

# Optional production contact form provider.
# The site still shows a direct support@kikoragear.com email fallback without these.
RESEND_API_KEY=your-resend-api-key
# The kikoragear.com sending domain is verified in Resend.
CONTACT_FROM_EMAIL=KIKORA <support@kikoragear.com>
CONTACT_TO_EMAIL=support@kikoragear.com

# Optional newsletter sender. If omitted, newsletter uses CONTACT_FROM_EMAIL.
# Customers receive an automatic welcome/recommended-products email after signup.
NEWSLETTER_FROM_EMAIL=KIKORA <support@kikoragear.com>
NEWSLETTER_NOTIFY_EMAIL=support@kikoragear.com
