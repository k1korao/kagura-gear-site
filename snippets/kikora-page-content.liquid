{%- liquid
  assign active_locale = locale | default: settings.default_language | default: 'zh'
  if active_locale == 'auto'
    assign active_locale = request.locale.iso_code | slice: 0, 2
  endif
  unless active_locale == 'en' or active_locale == 'ja'
    assign active_locale = 'zh'
  endunless
-%}
{%- assign active_route = route -%}
{%- if request.page_type == 'page' -%}{%- assign active_route = page.handle | prepend: '/pages/' -%}{%- endif -%}
{%- case active_route -%}
{%- when '/' -%}
<div id="kikora-root" data-route="/" data-locale="{{ active_locale }}">
{%- case active_locale -%}
{%- when 'zh' -%}
{% render 'kikora-render-home-zh-1' %}
{%- when 'en' -%}
{% render 'kikora-render-home-en-1' %}
{%- when 'ja' -%}
{% render 'kikora-render-home-ja-1' %}
{%- endcase -%}
</div>
<script>window.KIKORA_PAGE={route:"/",locale:{{ active_locale | json }},prerendered:true};</script>
{%- when '/pages/glass', '/explore/glass' -%}
