{%- liquid
  assign active_locale = locale | default: settings.default_language | default: 'zh'
  if active_locale == 'auto'
    assign active_locale = request.locale.iso_code | slice: 0, 2
  endif
  unless active_locale == 'en' or active_locale == 'ja'
    assign active_locale = 'zh'
  endunless
-%}
{%- liquid
  assign active_route = request.path
  if request.page_type == 'index'
    assign active_route = '/'
  elsif request.page_type == 'page'
    assign active_route = page.handle | prepend: '/pages/'
  endif
  assign kikora_title = page_title | default: 'KIKORA — Collect Your World'
  assign kikora_description = page_description
  assign kikora_image = 'kikora-brand-kikora-search-cover.webp' | asset_url
-%}
{%- if kikora_description == blank -%}{%- case active_locale -%}
{%- when 'zh' -%}{%- assign kikora_description = 'KIKORA（Kikora Gear）以游戏、动漫与独立艺术为灵感，探索玻璃鼠标垫、键帽及未来的金属客制化。浏览基础、画师与专辑封面系列的设计概念，了解品牌故事与共创计划。' -%}
{%- when 'en' -%}{%- assign kikora_description = 'Meet KIKORA (Kikora Gear): glass mousepads, keycaps and future metal customs inspired by games, anime and independent art. Explore the Core, Artist and Cover design studies, and the story behind the brand.' -%}
{%- when 'ja' -%}{%- assign kikora_description = 'ゲームやアニメ、独立した作家の表現から生まれるKIKORA。ガラスマウスパッドとキーキャップのデザイン、今後のメタルカスタム構想、ブランドの物語をご紹介します。' -%}
{%- endcase -%}{%- endif -%}
{%- case active_route -%}
{%- when '/' -%}{%- case active_locale -%}
{%- when 'zh' -%}{%- assign kikora_title = 'KIKORA (Kikora Gear) | 玻璃鼠标垫、键帽与艺术收藏' -%}
{%- when 'en' -%}{%- assign kikora_title = 'KIKORA (Kikora Gear) | Glass Mousepads, Keycaps & Artist Editions' -%}
{%- when 'ja' -%}{%- assign kikora_title = 'KIKORA (Kikora Gear) | ガラスマウスパッド・キーキャップとアート' -%}
{%- endcase -%}
{%- when '/pages/glass' -%}{%- case active_locale -%}
{%- when 'zh' -%}{%- assign kikora_title = '玻璃鼠标垫 | KIKORA' -%}
{%- when 'en' -%}{%- assign kikora_title = 'Glass mousepads | KIKORA' -%}
{%- when 'ja' -%}{%- assign kikora_title = 'ガラスマウスパッド | KIKORA' -%}
{%- endcase -%}
